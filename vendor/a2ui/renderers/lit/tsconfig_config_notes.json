# AUTOPLACEHOLDER_ANNOTATION: vendor/a2ui/renderers/lit/tsconfig.json
# Purpose: File in vendor area for project orchestration/configuration/data.
# Area: Vendored third-party code/assets (e.g., bundled UI runtime)
# System effect: Change can influence vendored third-party code/assets (e.g., bundled ui runtime) and therefore affects build/runtime behavior indirectly.
{
  "$schema": "https://json.schemastore.org/tsconfig",

  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    // "allowJs": true,
    "preserveWatchOutput": true,
    "sourceMap": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
