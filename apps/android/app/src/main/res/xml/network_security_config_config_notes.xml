<!-- AUTOPLACEHOLDER_ANNOTATION -->
<annotation path="apps/android/app/src/main/res/xml/network_security_config.xml">
  <purpose>File in apps area for project orchestration/configuration/data.</purpose>
  <area>Native apps (macOS / iOS / Android / shared app assets)</area>
  <impact>Change can influence native apps (macos / ios / android / shared app assets) and therefore affects build/runtime behavior indirectly.</impact>
</annotation>
<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
  <!-- This app is primarily used on a trusted tailnet; allow cleartext for IP-based endpoints too. -->
  <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
  <!-- Allow HTTP for tailnet/local dev endpoints (e.g. canvas/background web). -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">openclaw.local</domain>
  </domain-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">ts.net</domain>
  </domain-config>
</network-security-config>
