# AUTOPLACEHOLDER_ANNOTATION: .markdownlint-cli2.jsonc
# Purpose: File in .markdownlint-cli2.jsonc area for project orchestration/configuration/data.
# Area: A repository component with localized responsibility
# System effect: Change can influence a repository component with localized responsibility and therefore affects build/runtime behavior indirectly.
{
  "globs": ["docs/**/*.md", "docs/**/*.mdx", "README.md"],
  "ignores": ["docs/zh-CN/**", "docs/.i18n/**", "docs/reference/templates/**", "**/.local/**"],
  "config": {
    "default": true,

    "MD013": false,
    "MD025": false,
    "MD029": false,

    "MD033": {
      "allowed_elements": [
        "Note",
        "Info",
        "Tip",
        "Warning",
        "Card",
        "CardGroup",
        "Columns",
        "Steps",
        "Step",
        "Tabs",
        "Tab",
        "Accordion",
        "AccordionGroup",
        "CodeGroup",
        "Frame",
        "Callout",
        "ParamField",
        "ResponseField",
        "RequestExample",
        "ResponseExample",
        "img",
        "a",
        "br",
        "details",
        "summary",
        "p",
        "strong",
        "picture",
        "source",
        "Tooltip",
        "Check",
      ],
    },

    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false,
  },
}
